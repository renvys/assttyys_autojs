{
    "compilerOptions": {
        "target": "ES2019",
        "module": "CommonJS",
        "moduleResolution": "node",
        "lib": ["ES2019"],
        "types": ["node"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "rootDir": "../..",
        "outDir": "dist",
        "sourceMap": false,
        "declaration": false
    },
    "include": [
        "../../src/common/autoSelect.ts",
        "./**/*.ts"
    ],
    "exclude": ["dist"]
}
